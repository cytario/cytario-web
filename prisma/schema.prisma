datasource db {
provider = "postgresql"
}

generator client {
provider     = "prisma-client"
output       = "../app/.generated/"
moduleFormat = "esm"
}

enum BucketPolicyStatus {
none
applied
drifted
error
externally_managed @map("externally-managed")
}

model ConnectionConfig {
id                   String             @id @default(uuid())
name                 String
organization         String // Keycloak organization alias (tenant)
createdBy            String
bucketName           String
providerConnectionId String // reference to the portal-managed / OSS-configured provider connection (carries provider type, endpoint, region)
prefix               String             @default("")
bucketPolicyStatus   BucketPolicyStatus @default(none)

grants         ConnectionGrant[] @relation("ConnectionGrants")
recentlyViewed RecentlyViewed[]   @relation("RecentlyViewedConnection")
pinnedPaths    PinnedPath[]       @relation("PinnedPathConnection")

@@index([organization, providerConnectionId, bucketName, prefix])
@@index([organization, name])
}

model ConnectionGrant {
id             String            @id @default(uuid())
connectionId   String
scope          String // intra-org group path
accessLevel    String            // access level granted to the scope; the concrete storage role is resolved server-side from the catalog
connection     ConnectionConfig @relation("ConnectionGrants", fields: [connectionId], references: [id], onDelete: Cascade)

@@unique([connectionId, scope])
@@index([scope])
}

model RecentlyViewed {
id             String   @id @default(uuid())
userId         String
connectionId   String
connectionName String
pathName       String
name           String
type           String // "file" | "directory"
viewedAt       DateTime @default(now())

connection ConnectionConfig @relation("RecentlyViewedConnection", fields: [connectionId], references: [id], onDelete: Cascade)

@@unique([userId, connectionId, pathName])
@@index([userId])
}

model PinnedPath {
id             String    @id @default(uuid())
userId         String
connectionId   String
connectionName String
pathName       String
displayName    String
totalSize      BigInt?
lastModified   DateTime?

connection ConnectionConfig @relation("PinnedPathConnection", fields: [connectionId], references: [id], onDelete: Cascade)

@@unique([userId, connectionId, pathName])
@@index([userId])
}

// Host-owned running-jobs ledger. Carries identifiers only — the provider job
// identifier, the grant's offline-session identifier, the organization, and the
// submitting user — never token or credential material. A row is created at
// submission and removed only after its grant's revocation is confirmed.
model JobLedgerEntry {
  id               String   @id @default(uuid())
  batchId          String?
  jobId            String
  offlineSessionId String
  organization     String
  owner            String
  inputS3Uris      String[]
  outputS3Uri      String
  connectionId     String
  roleArn          String
  region           String
  s3Endpoint       String?
  jobTokenHash     String?  @unique
  providerId       String?
  createdAt        DateTime @default(now())

  /// The batch's held credentials. A job cannot outlive the batch's
  /// authorization, so the two go together rather than being correlated by a
  /// hand-matched session id. Nullable for rows recorded before this table
  /// existed — they have no batch to relate to.
  credential       JobGrantCredential? @relation(fields: [batchId], references: [batchId], onDelete: Cascade)

  @@unique([organization, jobId])
  @@index([organization, owner])
  @@index([batchId])
}

/// The batch's held credentials — the refresh token and the cached access token
/// the broker mints from. Encrypted at rest at the application layer, and the one
/// place a batch's OAuth material lives; the ledger above holds only the job
/// token's hash. One record per batch, keyed by the batch identifier the ledger
/// rows carry, so the broker, keep-alive, revocation and collection all address
/// the same record through the same relation.
model JobGrantCredential {
  id                    String   @id @default(uuid())
  /// The relation's parent key, and the key the ledger rows carry.
  batchId               String   @unique
  /// The batch's Keycloak offline session, for keep-alive and revocation.
  offlineSessionId      String   @unique
  encryptedRefreshToken String
  encryptedAccessToken  String
  accessTokenExpiresAt  DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  /// Every job of the batch; the credential is collected when the last one goes.
  ledgerEntries         JobLedgerEntry[]
}
