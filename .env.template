# Services
WEB_HOST=http://localhost:3000
# Optional: customer portal base URL, surfaced to client plugin slots.
# Leave unset on deployments without a portal (e.g. OSS).
# PORTAL_HOST=http://localhost:3001

# Identity Provider (Keycloak from the devenv cluster; create the realm and
# `cytario-web` client once through the admin console — see README "Keycloak")
BASE_URL=http://localhost:8080/realms/master
CLIENT_ID=cytario-web
CLIENT_SECRET=1234567

# Dedicated Cyberduck OAuth Client (public client with PKCE for desktop application)
CYBERDUCK_CLIENT_ID=cyberduck

# KC Admin service account (client_credentials grant for KC Admin API operations)
KC_ADMIN_CLIENT_ID=cytario-web-admin
KC_ADMIN_CLIENT_SECRET=change-me

# KC Job-broker client (offline-capable job token grant + offline-session
# revocation). A dedicated confidential service-account client in the cytario
# realm holding only manage-users (the narrowest realm-management role
# covering the session-revocation endpoint).
KC_JOB_BROKER_CLIENT_ID=job-broker
KC_JOB_BROKER_CLIENT_SECRET=change-me

# Redis / Valkey
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional: Authentication for Redis/Valkey
# Leave commented out if your server doesn't require authentication
# REDIS_USERNAME=myuser  # For Redis 6+ ACL or Valkey with username-based auth
# REDIS_PASSWORD=mypassword
# REDIS_CA_CERT=
# REDIS_TLS_SERVER_NAME=

## Secrets
COOKIE_SECRET=dev-secret-change-in-production
JWT_SECRET=another-very-strong-secret

# Base64-encoded 32-byte AES-256-GCM key for secrets held in Postgres (the
# batch's broker credentials). Required in production; unset values are stored
# unencrypted outside production. Generate: openssl rand -base64 32
# DB_ENCRYPTION_KEY=change-me-base64-32-bytes

# Database (Prisma)
DATABASE_URL="postgresql://cytario:cytario@localhost:5433/cytario"

# Provider catalog (connection-creation & share selectors).
# Admin-portal builds (EE/SaaS): set PORTAL_INTERNAL_URL to enable the portal
# lookup (GET {PORTAL_INTERNAL_URL}/org/providers) and share the lookup secret.
# PORTAL_INTERNAL_URL=http://portal.internal:4000
# PROVIDERS_LOOKUP_SECRET=change-me
# OSS self-hosted builds (no portal): point at a deploy-time YAML catalog file
# (see devenv/providers.example.yaml). Used only when PORTAL_INTERNAL_URL is unset.
# PROVIDERS_OSS_CONFIG_PATH=/etc/cytario/providers.yaml

# Service-to-service connections API (POST /api/connections): the admin
# portal presents this shared secret in the X-Connections-API-Secret header.
# Unset = the API rejects every request (fail closed).
# CONNECTIONS_API_SECRET=change-me
# Platform-managed bucket allowlist (comma-separated): the only buckets whose
# connections may be created with managedExternally on the API (the demo
# bucket). Unset = every managedExternally create is rejected (fail closed).
# CONNECTIONS_API_MANAGED_BUCKETS=cytario-demo

# CSP connect-src allowlist for S3 hosts the browser may talk to directly
# (SigV4-signed fetches). REPLACES the defaults (https://*.amazonaws.com,
# https://*.cytario.com) — a self-hosted S3-compatible endpoint (e.g. the
# devenv RustFS on http://localhost:9000) must be listed here alongside the
# defaults you want to keep.
# CYTARIO_ALLOWED_S3_HOSTS=http://localhost:9000,https://*.amazonaws.com,https://*.cytario.com
